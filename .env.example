# This is a key map only. Create the real deployment file with
# infra/deploy/bootstrap-vm.sh on the VM; never commit its generated values.
CHATWOOT_HOSTNAME=chat.example.com
MANAGEMENT_HOSTNAME=management.example.com
AI_HOSTNAME=ai.example.com
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_API_KEY=runtime-only

# AI service bounded timeouts and conversation context lifetime.
MANAGEMENT_TIMEOUT_SECONDS=5
CHATWOOT_TIMEOUT_SECONDS=8
OPENROUTER_TIMEOUT_SECONDS=15
PROCESSING_TIMEOUT_SECONDS=25
AI_CONTEXT_TTL_SECONDS=86400
LINE_CHANNEL_ID=runtime-only
LINE_CHANNEL_SECRET=runtime-only
LINE_CHANNEL_ACCESS_TOKEN=runtime-only

# Management primary-image uploads. Keep the token in the runtime .env only.
CLOUDFLARE_IMAGES_ACCOUNT_ID=runtime-only
CLOUDFLARE_IMAGES_API_TOKEN=runtime-only
CLOUDFLARE_IMAGES_DELIVERY_BASE_URL=https://imagedelivery.net/account-hash
CLOUDFLARE_IMAGES_VARIANT=public
CLOUDFLARE_IMAGES_DIRECT_UPLOAD_EXPIRY_MINUTES=10
PROPERTY_IMAGE_UPLOAD_DRIVER=cloudflare_images
R2_ACCESS_KEY_ID=runtime-only
R2_SECRET_ACCESS_KEY=runtime-only
R2_BUCKET=runtime-only
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://images.example.com
R2_DIRECT_UPLOAD_EXPIRY_MINUTES=10
