APP_ENV=local
LOG_LEVEL=INFO

CHATWOOT_BASE_URL=http://chatwoot-rails:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_BOT_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_TOKEN=
CHATWOOT_HANDOFF_TEAM_ID=
CHATWOOT_ALLOWED_INBOX_IDS=

# Reuse the private Chatwoot Redis instance for durable webhook delivery.
REDIS_URL=redis://:password@chatwoot-redis:6379

MANAGEMENT_BASE_URL=http://management-nginx
AI_SERVICE_TOKEN=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# Bounded upstream and processing timeouts (seconds).
MANAGEMENT_TIMEOUT_SECONDS=5
CHATWOOT_TIMEOUT_SECONDS=8
OPENROUTER_TIMEOUT_SECONDS=15
PROCESSING_TIMEOUT_SECONDS=25
AI_CONTEXT_TTL_SECONDS=86400
