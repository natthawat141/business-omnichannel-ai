APP_NAME="Aion3 Knowledge Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production target is MySQL. SQLite is only for local/dev/test convenience.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=line_knowledge
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Images Direct Creator Upload. The API token requires
# Account > Cloudflare Images > Edit and must remain server-side only.
CLOUDFLARE_IMAGES_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_BASE_URL=
CLOUDFLARE_IMAGES_VARIANT=public
CLOUDFLARE_IMAGES_DIRECT_UPLOAD_EXPIRY_MINUTES=10

# Primary image provider: cloudflare_images or r2.
PROPERTY_IMAGE_UPLOAD_DRIVER=cloudflare_images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_DIRECT_UPLOAD_EXPIRY_MINUTES=10

# ---------------------------------------------------------------------------
# Admin seeding — the seeder creates ONE admin from these values.
# Never commit a real password. Leave blank in production and set at deploy.
# ---------------------------------------------------------------------------
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Remote MCP: leave disabled until migrations, signing keys and HTTPS are ready.
REMOTE_MCP_ENABLED=false
REMOTE_MCP_REDIRECT_ORIGINS="http://localhost,http://127.0.0.1,https://chatgpt.com,https://claude.ai"
